{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETH Search Studio",
  "version": "0.1.0",
  "identifier": "dev.ethsearch.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ETH Search Studio",
        "width": 1360,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "theme": "Dark",
        "transparent": false,
        "backgroundColor": "#101217"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["engine/words-breaker.exe"],
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
